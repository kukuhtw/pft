APP_NAME="AI Personal Finance Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: MySQL 8.4 LTS (DB_CONNECTION=mysql). Local XAMPP MariaDB: DB_CONNECTION=mariadb.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pft
DB_USERNAME=pft
# Never commit a real password. Use a dedicated least-privilege DB user, not root.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Finance (config/finance.php) ---
FINANCE_DISPLAY_TIMEZONE=Asia/Jakarta
FINANCE_DEFAULT_CURRENCY=IDR
# Hours an Idempotency-Key is honoured before finance:prune may delete it
IDEMPOTENCY_TTL_HOURS=72
# Audit-log retention in days (0 = keep forever). ISO/IEC 27001 A.8.10
AUDIT_RETENTION_DAYS=2555

# --- Dashboard login (config/access.php) ---
# Dashboard account: run `php artisan dashboard:user` after changing these.
# Login always checks the database (bcrypt), never this file.
# Plain password: ≥12 chars with upper case, lower case and a digit. Put it in single quotes
# if it contains $, #, spaces or quotes. Example: DASHBOARD_ADMIN_PASSWORD='Ganti-Ini-2026'
# (Optional, safer: a bcrypt hash from `php artisan dashboard:user --hash`, also in single quotes.)
DASHBOARD_ADMIN_NAME=Admin
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=
# false = no self sign-up on /register or POST /api/v1/auth/register
AUTH_REGISTRATION_ENABLED=false
# Only these emails may sign in or register (comma-separated). Empty = every registered user.
AUTH_ALLOWED_EMAILS=

# --- Sanctum API tokens ---
# Token lifetime in minutes (default 30 days)
SANCTUM_TOKEN_EXPIRATION=43200

# --- Telegram bot (optional; off while empty). See documentation/telegram-bot.html ---
# Token from @BotFather. Secret: php -r "echo bin2hex(random_bytes(32));"
# Register: php artisan telegram:webhook set   (needs a public HTTPS APP_URL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TTL_MINUTES=10
# Telegram user ids allowed to use the bot, comma-separated (e.g. 123456789,987654321).
# Empty = the bot answers nobody. Find your id with @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# --- Later phases (leave empty until implemented) ---
# AI_PROVIDER_BASE_URL=
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_MODEL=


# Landing page contact person (empty LANDING_CONTACT_WHATSAPP hides it)
# LANDING_CONTACT_NAME="Kukuh TW"
# LANDING_CONTACT_WHATSAPP=628129893706
