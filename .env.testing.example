# Copy to .env.testing (git-ignored). Laravel loads it automatically when APP_ENV=testing.
APP_ENV=testing
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=
APP_LOCALE=id

# Fast feedback (concurrency tests are skipped on SQLite):
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Full MySQL/MariaDB integration run (required before a release):
# DB_CONNECTION=mysql        # or mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pft_test       # dedicated database: tests run migrate:fresh on it
# DB_USERNAME=pft
# DB_PASSWORD=
